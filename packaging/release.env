# The canfit release that the in-repository package manifests install: Formula/canfit.rb
# (Homebrew) and packaging/scoop/canfit.json (Scoop). This file is their single source of truth.
#
# Do not edit by hand. After a release, the "Package manifests" workflow (or
# `packaging/render.sh VERSION CHECKSUM_DIR` run locally) rewrites it from the release's .sha256
# files and re-renders both manifests; see packaging/README.md.
#
# All-zero checksums mean the version has not been released yet: the manifests then fail with a
# checksum mismatch instead of installing anything.
VERSION=1.0.0
SHA256_MACOS_AARCH64=819d3795d6b638ce43040ad8fe5ea6a4a091970b8aab883a61298bdb4749e96d
